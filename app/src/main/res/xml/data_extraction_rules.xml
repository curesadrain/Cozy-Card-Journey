<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="cozy_cards.db" />
        <include domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="cozy_cards.db" />
        <include domain="file" path="backups/" />
        <include domain="file" path="card_images/" />
    </device-transfer>
</data-extraction-rules>
